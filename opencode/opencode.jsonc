{
  "$schema": "https://opencode.ai/config.json",
  // Split providers to ensure baseURL is respected for each server
  "enabled_providers": [
    "local_util",
    "local_coder",
    "local_thinker"
  ],
  "provider": {
    "local_util": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Utility",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "model": {
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    },
    "local_coder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Coder",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "model": {
          "tool_call": false,
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    },
    "local_thinker": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Thinker",
      "options": {
        "baseURL": "http://127.0.0.1:8003/v1",
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "model": {
          "tool_call": false,
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  },
  // Default model for normal "build"
  "model": "local_thinker/model",
  "small_model": "local_util/model",
  // Global tool safety: require approval for edits + shell
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  // MCP servers
  "mcp": {
    "archon": {
      "type": "remote",
      "url": "http://127.0.0.1:8181/mcp",
      "enabled": true
    }
  },
  "plugin": [
    "opencode-mem"
  ],
  // Agents (primary)
  "agent": {
    "build": {
      "description": "Implement changes (normal mode)",
      "mode": "primary",
      "model": "local_coder/model",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "description": "Plan/review without changing code",
      "mode": "primary",
      "model": "local_thinker/model",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    // Ultra Work Mode
    "ultra": {
      "description": "Long-horizon, multi-pass implementation with rigorous checks",
      "mode": "primary",
      "model": "local_coder/model",
      "prompt": "@opencode/agents/ultra.md",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    // Subagents
    "review": {
      "description": "Review code changes for errors and best practices",
      "mode": "primary",
      "model": "local_thinker/model",
      "prompt": "@opencode/agents/review.md",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "code-reviewer": {
      "description": "Legacy alias for review agent",
      "mode": "primary",
      "model": "local_thinker/model",
      "prompt": "@opencode/agents/review.md",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "util": {
      "description": "Fast helper for summarization, repo scanning commands",
      "mode": "subagent",
      "model": "local_util/model",
      "prompt": "@opencode/agents/util.md",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}