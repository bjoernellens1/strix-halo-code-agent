{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": {
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "util": {
          "name": "Utility",
          "baseURL": "http://127.0.0.1:8001/v1",
          "tool_call": false,
          "vision": true,
          "limit": {
            "context": 8192,
            "output": 2048
          }
        },
        "coder": {
          "name": "Coder",
          "baseURL": "http://127.0.0.1:8002/v1",
          "tool_call": false,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "thinker": {
          "name": "Thinker",
          "baseURL": "http://127.0.0.1:8003/v1",
          "tool_call": false,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "llamacpp/coder",
  "small_model": "llamacpp/util",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "agent": {
    "orchestrator": {
      "description": "Master controller: delegates, keeps process tight",
      "mode": "primary",
      "model": "llamacpp/thinker",
      "prompt": "@opencode/agents/orchestrator.md",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "explorer": {
      "description": "Repo navigator: locate files/symbols quickly",
      "mode": "subagent",
      "model": "llamacpp/util",
      "prompt": "@opencode/agents/explorer.md",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "librarian": {
      "description": "Local knowledge retriever: codemap, docs, cache",
      "mode": "subagent",
      "model": "llamacpp/util",
      "prompt": "@opencode/agents/librarian.md",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "fixer": {
      "description": "Implements code changes",
      "mode": "subagent",
      "model": "llamacpp/coder",
      "prompt": "@opencode/agents/fixer.md",
      "tools": {
        "bash": true,
        "edit": true,
        "write": true
      }
    },
    "ultra": {
      "description": "Ultra work mode: multi-pass implement + verify",
      "mode": "primary",
      "model": "llamacpp/coder",
      "prompt": "@opencode/agents/ultra.md",
      "tools": {
        "bash": true,
        "edit": true,
        "write": true
      }
    }
  }
}