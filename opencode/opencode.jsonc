{
  "$schema": "https://opencode.ai/config.json",

  // Prefer local-only usage
  "enabled_providers": ["local_llamacpp"],

  "provider": {
    "local_llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": {
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "util":   { "name": "Utility (llama.cpp)", "baseURL": "http://127.0.0.1:8001/v1", "tool_call": true,
                    "limit": { "context": 8192,  "output": 2048 } },
        "coder":  { "name": "Coder (llama.cpp)",   "baseURL": "http://127.0.0.1:8002/v1", "tool_call": false,
                    "limit": { "context": 32768, "output": 4096 } },
        "thinker":{ "name": "Thinker (llama.cpp)", "baseURL": "http://127.0.0.1:8003/v1", "tool_call": false,
                    "limit": { "context": 32768, "output": 4096 } }
      }
    }
  },

  // Default model for normal "build"
  "model": "local_llamacpp/coder",
  "small_model": "local_llamacpp/util",

  // Global tool safety: require approval for edits + shell
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  // Keep long tasks coherent
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },

  // MCP servers
  "mcp": {
    "archon": {
      "type": "remote",
      "url": "http://127.0.0.1:8181/mcp",
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },

  // Optional plugin memory (see README below)
  "plugin": ["opencode-mem"],

  // Agents (primary)
  "agent": {
    "build": {
      "description": "Implement changes (normal mode)",
      "mode": "primary",
      "model": "local_llamacpp/coder",
      "tools": { "write": true, "edit": true, "bash": true }
    },
    "plan": {
      "description": "Plan/review without changing code",
      "mode": "primary",
      "model": "local_llamacpp/thinker",
      "tools": { "write": false, "edit": false, "bash": false }
    },

    // Ultra Work Mode
    "ultra": {
      "description": "Long-horizon, multi-pass implementation with rigorous checks",
      "mode": "primary",
      "model": "local_llamacpp/coder",
      "prompt": "@opencode/agents/ultra.md",
      "tools": { "write": true, "edit": true, "bash": true }
    },

    // Subagents (fast helpers)
    "util": {
      "description": "Fast helper for summarization, repo scanning instructions, command drafting",
      "mode": "subagent",
      "model": "local_llamacpp/util",
      "tools": { "write": false, "edit": false, "bash": false }
    }
  }
}
