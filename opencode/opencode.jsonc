{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp_util": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp util",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "util": {
          "name": "Utility",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    },
    "llamacpp_coder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp coder",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "coder": {
          "name": "Coder",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "llamacpp_thinker": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp thinker",
      "options": {
        "baseURL": "http://127.0.0.1:8003/v1",
        "apiKey": "EMPTY",
        "timeout": 600000
      },
      "models": {
        "thinker": {
          "name": "Thinker",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "llamacpp_coder/coder",
  "small_model": "llamacpp_util/util",
  "mcp": {
    "searxng": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:8787/mcp"
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "ask",
    "webfetch": "ask",
    "mcp.*": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "agent": {
    "orchestrator": {
      "description": "Master controller: delegates, keeps process tight",
      "mode": "primary",
      "model": "llamacpp_thinker/thinker",
      "prompt": "@opencode/agents/orchestrator.md",
      "tools": {
        "bash": true,
        "edit": false,
        "write": false
      }
    },
    "explorer": {
      "description": "Repo navigator: locate files/symbols quickly",
      "mode": "subagent",
      "model": "llamacpp_util/util",
      "prompt": "@opencode/agents/explorer.md",
      "tools": {
        "bash": true,
        "edit": false,
        "write": false
      }
    },
    "librarian": {
      "description": "Local knowledge retriever: codemap, docs, cache",
      "mode": "subagent",
      "model": "llamacpp_util/util",
      "prompt": "@opencode/agents/librarian.md",
      "tools": {
        "bash": true,
        "edit": false,
        "write": false
      }
    },
    "web_librarian": {
      "description": "Find docs + recent discussions via SearXNG, summarize with citations",
      "mode": "subagent",
      "model": "llamacpp_util/util",
      "prompt": "@opencode/agents/web_librarian.md",
      "tools": {
        "bash": true,
        "edit": false,
        "write": false
      }
    },
    "fixer": {
      "description": "Implements code changes",
      "mode": "subagent",
      "model": "llamacpp_coder/coder",
      "prompt": "@opencode/agents/fixer.md",
      "tools": {
        "bash": true,
        "edit": true,
        "write": true
      }
    },
    "ultra": {
      "description": "Ultra work mode: multi-pass implement + verify",
      "mode": "primary",
      "model": "llamacpp_coder/coder",
      "prompt": "@opencode/agents/ultra.md",
      "tools": {
        "bash": true,
        "edit": true,
        "write": true
      }
    }
  }
}