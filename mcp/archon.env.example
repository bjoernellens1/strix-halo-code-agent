# Archon Environment Variables
# See Archon documentation for details
# OpenAI Compatible (Local Thinker)
OPENAI_API_KEY=dummy-key
OPENAI_BASE_URL=http://127.0.0.1:8003/v1

# Supabase (Required by Archon)
# You need a Supabase project (cloud or local).
# Get these from your Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
