# Model Paths (Absolute paths required)
# Utility: ~7B-8B (e.g., Qwen2.5-7B-Instruct-Q4_K_M.gguf)
export MODEL_UTIL="/path/to/your/models/Qwen2.5-7B-Instruct-Q4_K_M.gguf"

# Coder: ~30B (e.g., Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf)
export MODEL_CODER="/path/to/your/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf"

# Thinker: ~20B-25B (e.g., GLM-4.7-Flash-REAP-23B-A3B-Q4_K_M.gguf)
export MODEL_THINKER="/path/to/your/models/GLM-4.7-Flash-REAP-23B-A3B-Q4_K_M.gguf"

# Optional Overrides
# export PORT_UTIL=8001
# export PORT_CODER=8002
# export PORT_THINKER=8003
# export CTX_UTIL=8192
# export CTX_CODER=32768
# export CTX_THINKER=32768
